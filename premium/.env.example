# ── Sitio ───────────────────────────────────────────────────────────────
# URL pública canónica (SEO, sitemap, hreflang, Open Graph).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Panel de administración (precios, inventario, pedidos) ──────────────
# Los clientes NO tienen cuenta: piden por WhatsApp. Solo existe el administrador.
# Ruta del panel (no enlazada en el sitio). Cámbiala por algo propio: /es/<ruta>
NEXT_PUBLIC_ADMIN_PATH=gestion
ADMIN_EMAIL=
# Mínimo 10 caracteres. Se aplica al arrancar (crea o actualiza al administrador).
ADMIN_PASSWORD=

# ── Sesión (OBLIGATORIO en producción) ──────────────────────────────────
# Mínimo 32 caracteres aleatorios:  openssl rand -base64 48
AUTH_SECRET=

# ── Persistencia de datos (pedidos, precios e inventario editados) ──────
# Vercel: Storage → Marketplace → Upstash Redis (crea estas variables solas).
# Sin ellas: archivos JSON en DATA_DIR (local/Docker) o memoria (Vercel: se pierde al reiniciar).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
DATA_DIR=.data

# ── Seguridad ────────────────────────────────────────────────────────────
# Desactivar solo en pruebas E2E.
RATE_LIMIT_ENABLED=true
