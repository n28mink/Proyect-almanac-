# ── Sitio ───────────────────────────────────────────────────────────────
# URL pública canónica (SEO, sitemap, Open Graph, URLs de retorno de pago).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Sesiones (OBLIGATORIO en producción) ─────────────────────────────────
# Mínimo 32 caracteres aleatorios:  openssl rand -base64 48
AUTH_SECRET=

# ── Administrador inicial ────────────────────────────────────────────────
# Se crea/actualiza al arrancar. Sin estas dos variables no existe usuario admin.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ── Pagos ────────────────────────────────────────────────────────────────
# mock  → pedido pagado al instante (demo; no se cobra nada)
# stripe → Stripe Checkout hospedado + webhook firmado
PAYMENT_PROVIDER=mock
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ── Datos ────────────────────────────────────────────────────────────────
# Carpeta del almacén JSON (usuarios, pedidos, overrides). En hosting de solo
# lectura (p. ej. Vercel) se usa memoria: sustituye el adaptador por una BD real.
DATA_DIR=.data

# ── Seguridad ────────────────────────────────────────────────────────────
# Desactivar solo en pruebas E2E.
RATE_LIMIT_ENABLED=true
